    "input.placeholderForeground": "#5A5D70",
    "dropdown.background": "#12131A",
    "dropdown.border": "#2A1A22",
    "button.background": "#B5121C",
    "button.foreground": "#FFFFFF",
    "button.hoverBackground": "#E3242B",
    "badge.background": "#E3242B",
    "badge.foreground": "#FFFFFF",
    "progressBar.background": "#E3242B",
    "scrollbarSlider.background": "#3A3D4E66",
    "scrollbarSlider.hoverBackground": "#3A3D4EAA",
    "scrollbarSlider.activeBackground": "#E3242B88",
    "menu.background": "#12131A",
    "menu.selectionBackground": "#4A1520",
    "quickInput.background": "#12131A",
    "quickInputList.focusBackground": "#4A1520",
    "notifications.background": "#12131A",
    "peekView.border": "#E3242B",

    "terminal.background": "#0A0B10",
    "terminal.foreground": "#E4DEE2",
    "terminalCursor.foreground": "#FF3340",
    "terminal.selectionBackground": "#4A1520",
    "terminal.ansiBlack": "#0C0D12",
    "terminal.ansiRed": "#E3242B",
    "terminal.ansiGreen": "#FF8C94",
    "terminal.ansiYellow": "#FF6E6E",
    "terminal.ansiBlue": "#5B8CFF",
    "terminal.ansiMagenta": "#FF4D5A",
    "terminal.ansiCyan": "#A9C1FF",
    "terminal.ansiWhite": "#E4DEE2",
    "terminal.ansiBrightBlack": "#6B6880",
    "terminal.ansiBrightRed": "#FF3340",
    "terminal.ansiBrightGreen": "#FFB3B8",
    "terminal.ansiBrightYellow": "#FF9A9A",
    "terminal.ansiBrightBlue": "#8AAEFF",
    "terminal.ansiBrightMagenta": "#FF7A84",
    "terminal.ansiBrightCyan": "#C9D8FF",
    "terminal.ansiBrightWhite": "#FFFFFF",

    "gitDecoration.modifiedResourceForeground": "#5B8CFF",
    "gitDecoration.untrackedResourceForeground": "#FF8C94",
    "gitDecoration.deletedResourceForeground": "#8B0A14",
    "gitDecoration.ignoredResourceForeground": "#5A5D70"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#6B6880", "fontStyle": "italic" } },
    { "scope": ["keyword", "keyword.control", "storage", "storage.type", "storage.modifier"], "settings": { "foreground": "#E3242B" } },
    { "scope": ["keyword.operator", "punctuation.accessor"], "settings": { "foreground": "#FF4D5A" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#FF8C94" } },
    { "scope": ["constant.numeric", "constant.language", "constant.character", "variable.parameter", "variable.other.constant"], "settings": { "foreground": "#A9C1FF" } },
    { "scope": ["entity.name.function", "support.function", "meta.function-call.generic", "variable.function"], "settings": { "foreground": "#5B8CFF" } },
    { "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class", "entity.other.inherited-class"], "settings": { "foreground": "#FF6E6E" } },
    { "scope": ["variable", "variable.other"], "settings": { "foreground": "#F2ECEF" } },
    { "scope": ["entity.name.tag", "entity.other.attribute-name"], "settings": { "foreground": "#FF4D5A" } },
    { "scope": ["markup.heading", "entity.name.section"], "settings": { "foreground": "#FF8C94", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#A9C1FF" } },
    { "scope": ["markup.underline.link"], "settings": { "foreground": "#5B8CFF" } },
    { "scope": ["invalid"], "settings": { "foreground": "#8B0A14" } },
    { "scope": ["invalid.deprecated"], "settings": { "foreground": "#3D4F8F" } }
  ]
}
