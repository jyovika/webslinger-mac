    "editor.inactiveSelectionBackground": "#4A152080",
    "editor.lineHighlightBackground": "#181A24",
    "editor.findMatchBackground": "#E3242B66",
    "editor.findMatchHighlightBackground": "#E3242B33",
    "editor.wordHighlightBackground": "#3A3D4E80",
    "editorBracketMatch.background": "#3A3D4E",
