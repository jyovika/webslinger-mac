.editor_dark.ace_editor_theme a {
   color: #FFF !important;
}

.ace_layer {
   z-index: 3;
}

.ace_layer.ace_print-margin-layer {
   z-index: 2;
}

.ace_layer.ace_marker-layer {
   z-index: 1;
}
.rstudio-themes-dark-menus .ace_editor.ace_autocomplete {
   background: #2f3941;
   border: solid 1px #4e5c68 !important;
   color: #f0f0f0;
}

.rstudio-themes-dark-menus .ace_editor.ace_autocomplete .ace_marker-layer .ace_active-line,
.rstudio-themes-dark-menus .ace_editor.ace_autocomplete .ace_marker-layer .ace_line-hover {
   background: rgba(255, 255, 255, 0.15);
   border: none
}
/* Rainbow indent lines */
.rstudio_rainbow_indent_guides .ace_line .ace_indent-guide:nth-child(7n+1){
    background: linear-gradient(to left, #ed90a4bb 1px, transparent 1px, transparent);
}
.rstudio_rainbow_indent_guides .ace_line .ace_indent-guide:nth-child(7n+2){
    background: linear-gradient(to left, #d3a263bb 1px, transparent 1px, transparent);
}
.rstudio_rainbow_indent_guides .ace_line .ace_indent-guide:nth-child(7n+3){
    background: linear-gradient(to left, #99b657bb 1px, transparent 1px, transparent);
}
.rstudio_rainbow_indent_guides .ace_line .ace_indent-guide:nth-child(7n+4){
    background: linear-gradient(to left, #33c192bb 1px, transparent 1px, transparent);
}
.rstudio_rainbow_indent_guides .ace_line .ace_indent-guide:nth-child(7n+5){
    background: linear-gradient(to left, #00bdcebb 1px, transparent 1px, transparent);
}
.rstudio_rainbow_indent_guides .ace_line .ace_indent-guide:nth-child(7n+6){
    background: linear-gradient(to left, #94a9ebbb 1px, transparent 1px, transparent);
}
.rstudio_rainbow_indent_guides .ace_line .ace_indent-guide:nth-child(7n+7){
    background: linear-gradient(to left, #dc91dbbb 1px, transparent 1px, transparent);
}
/* Rainbow indent fills */
.rstudio_rainbow_indent_fills .ace_line .ace_indent-guide:nth-child(7n+1){
    background: linear-gradient(to left, #ed90a4bb 1px, #ed90a477 1px, #ed90a477 );
}
.rstudio_rainbow_indent_fills .ace_line .ace_indent-guide:nth-child(7n+2){
    background: linear-gradient(to left, #d3a263bb 1px, #d3a26377 1px, #d3a26377 );
}
.rstudio_rainbow_indent_fills .ace_line .ace_indent-guide:nth-child(7n+3){
    background: linear-gradient(to left, #99b657bb 1px, #99b65777 1px, #99b65777 );
}
.rstudio_rainbow_indent_fills .ace_line .ace_indent-guide:nth-child(7n+4){
    background: linear-gradient(to left, #33c192bb 1px, #33c19277 1px, #33c19277 );
}
.rstudio_rainbow_indent_fills .ace_line .ace_indent-guide:nth-child(7n+5){
    background: linear-gradient(to left, #00bdcebb 1px, #00bdce77 1px, #00bdce77 );
}
.rstudio_rainbow_indent_fills .ace_line .ace_indent-guide:nth-child(7n+6){
    background: linear-gradient(to left, #94a9ebbb 1px, #94a9eb77 1px, #94a9eb77 );
}
.rstudio_rainbow_indent_fills .ace_line .ace_indent-guide:nth-child(7n+7){
    background: linear-gradient(to left, #dc91dbbb 1px, #dc91db77 1px, #dc91db77 );
}
