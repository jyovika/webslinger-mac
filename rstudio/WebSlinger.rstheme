/* rs-theme-name: WebSlinger */
/* rs-theme-is-dark: TRUE */
.ace_gutter {
  background: #12131A;
  color: #E4DEE2
}
.ace_print-margin {
  width: 1px;
  background: #2A1A22;
}
.ace_editor, .ace_editor_theme .profvis-flamegraph, .ace_editor_theme {
  background-color: #0C0D12;
  color: #E4DEE2
}
.ace_cursor {
  color: #FF3340
}
.ace_marker-layer .ace_selection {
  background: #4A1520
}
.ace_selection.ace_start {
  box-shadow: 0 0 3px 0px #0C0D12;
  border-radius: 2px;
}
.ace_marker-layer .ace_step {
  background: rgb(102, 82, 0)
}
.ace_marker-layer .ace_bracket {
  margin: -1px 0 0 -1px;
  border: 1px solid #3A3D4E
}
.ace_marker-layer .ace_active-line {
  background: #181A24
}
.ace_gutter-active-line {
  background-color: #181A24
}
.ace_marker-layer .ace_selected-word {
  border: 1px solid #4A1520
}
.ace_invisible {
  color: #3A3D4E
}
.ace_keyword,
.ace_meta,
.ace_storage,
.ace_storage.ace_type,
.ace_support.ace_type {
  color: #E3242B
}
.ace_keyword.ace_operator {
  color: #FF4D5A
}
.ace_constant.ace_character,
.ace_constant.ace_language,
.ace_constant.ace_numeric,
.ace_keyword.ace_other.ace_unit,
.ace_support.ace_constant,
.ace_variable.ace_parameter {
  color: #A9C1FF
}
.ace_constant.ace_other {
  color: #E4DEE2
}
.ace_invalid {
  color: #E4DEE2;
  background-color: #8B0A14
}
.ace_invalid.ace_deprecated {
  color: #E4DEE2;
  background-color: #3D4F8F
}
.ace_fold {
  background-color: #5B8CFF;
  border-color: #E4DEE2
}
.ace_entity.ace_name.ace_function,
.ace_support.ace_function,
.ace_variable {
  color: #5B8CFF
}
.ace_support.ace_class,
.ace_support.ace_type {
  color: #FF6E6E
}
.ace_heading,
.ace_markup.ace_heading,
.ace_string {
  color: #FF8C94
}
.ace_entity.ace_name.ace_tag,
.ace_entity.ace_other.ace_attribute-name,
.ace_meta.ace_tag,
.ace_string.ace_regexp,
.ace_variable {
  color: #F2ECEF
}
.ace_comment {
  color: #6B6880
}
.ace_indent-guide {
  background: url(data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAAEAAAACCAYAAACZgbYnAAAAEklEQVQImWNgYGBgYHB3d/8PAAOIAdULw8qMAAAAAElFTkSuQmCC) right repeat-y
}
.nocolor.ace_editor .ace_line span {
  color: #E3242B !important;
}
.ace_bracket {
  margin: 0 !important;
  border: 0 !important;
  background-color: rgba(128, 128, 128, 0.5);
}
.ace_marker-layer .ace_foreign_line {
  position: absolute;
  z-index: -1;
  background-color: #2E3032;
}
.ace_node-selector {
  background-color: #fb6f1c
}
.ace_comment-highlight {
  color: #4D4333;
  background-color: #D1B78A;
}
.ace_marker-layer .ace_active_debug_line {
  position: absolute;
  z-index: -1;
}
.ace_marker-layer .ace_find_line {
  position: absolute;
  z-index: -1;
  background-color: #3F4142;
}
.ace_console_error {
  background-color: #3F4142;
}
.terminal {
  background-color: #0C0D12;
  color: #E4DEE2;
  font-feature-settings: "liga" 0;
  position: relative;
  user-select: none;
  -ms-user-select: none;
  -webkit-user-select: none;
}
.terminal.xterm-cursor-style-block.focus:not(.xterm-cursor-blink-on) .terminal-cursor {
  background-color: #CCC;
  color: #1e1e1e;
}
.terminal.focus.xterm-cursor-style-bar:not(.xterm-cursor-blink-on) .terminal-cursor::before,
.terminal.focus.xterm-cursor-style-underline:not(.xterm-cursor-blink-on) .terminal-cursor::before {
  content: '';
  position: absolute;
  background-color: #CCC;
}
.terminal:not(.focus) .terminal-cursor {
  outline: 1px solid #CCC;
  outline-offset: -1px;
}
.terminal .xterm-selection div {
   position: absolute;
   background-color: #CCC;
}
.terminal .xterm-viewport {
  background-color: #0C0D12;
  overflow-y: scroll;
}

.ace_comment { font-style: italic; }
