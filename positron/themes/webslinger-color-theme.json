    "editorWhitespace.foreground": "#3A3D4E",
    "editorRuler.foreground": "#1C1E28",
    "editorError.foreground": "#FF3340",
    "editorWarning.foreground": "#FF8C94",
    "editorInfo.foreground": "#5B8CFF",
    "editorWidget.background": "#12131A",
    "editorWidget.border": "#2A1A22",
    "editorSuggestWidget.selectedBackground": "#4A1520",
    "editorHoverWidget.background": "#12131A",
    "editorHoverWidget.border": "#2A1A22",
    "editorGroupHeader.tabsBackground": "#08090D",
    "editorGroup.border": "#2A1A22",

    "tab.activeBackground": "#0C0D12",
    "tab.activeForeground": "#E4DEE2",
    "tab.activeBorderTop": "#E3242B",
    "tab.inactiveBackground": "#08090D",
    "tab.inactiveForeground": "#6B6880",
    "tab.border": "#08090D",

    "activityBar.background": "#08090D",
    "activityBar.foreground": "#E3242B",
    "activityBar.inactiveForeground": "#5A5D70",
    "activityBar.activeBorder": "#E3242B",
    "activityBarBadge.background": "#E3242B",
    "activityBarBadge.foreground": "#FFFFFF",
    "sideBar.background": "#0A0B10",
    "sideBar.foreground": "#C9C3C8",
    "sideBar.border": "#2A1A22",
    "sideBarTitle.foreground": "#E4DEE2",
    "sideBarSectionHeader.background": "#12131A",
    "sideBarSectionHeader.foreground": "#E4DEE2",
    "list.activeSelectionBackground": "#4A1520",
    "list.activeSelectionForeground": "#FFFFFF",
    "list.inactiveSelectionBackground": "#2A1218",
    "list.hoverBackground": "#181A24",
    "list.highlightForeground": "#FF4D5A",
    "list.focusOutline": "#E3242B80",

    "titleBar.activeBackground": "#08090D",
    "titleBar.activeForeground": "#E4DEE2",
    "titleBar.inactiveBackground": "#08090D",
    "titleBar.border": "#2A1A22",
    "statusBar.background": "#8B0A14",
    "statusBar.foreground": "#FFFFFF",
    "statusBar.noFolderBackground": "#4A1520",
    "statusBar.debuggingBackground": "#3D4F8F",
    "statusBarItem.remoteBackground": "#E3242B",
    "panel.background": "#0A0B10",
    "panel.border": "#2A1A22",
    "panelTitle.activeForeground": "#E4DEE2",
    "panelTitle.activeBorder": "#E3242B",
    "panelTitle.inactiveForeground": "#6B6880",

    "input.background": "#12131A",
    "input.border": "#2A1A22",
