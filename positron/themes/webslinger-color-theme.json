{
  "name": "WebSlinger",
  "type": "dark",
  "semanticHighlighting": false,
  "colors": {
    "focusBorder": "#E3242B80",
    "foreground": "#E4DEE2",
    "descriptionForeground": "#9A96A8",
    "errorForeground": "#FF6B6B",
    "widget.border": "#2A1A22",
    "selection.background": "#4A1520",
    "textLink.foreground": "#5B8CFF",
    "textLink.activeForeground": "#A9C1FF",

    "editor.background": "#0C0D12",
